# ==============================================================================
# KRISHIBONDHU - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Database, Authentication & Storage)
# ------------------------------------------------------------------------------
# Public Supabase URL for client & server connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (safe for browser client with RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-Only Supabase Service Role Key (Bypasses RLS - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. AI Gateway Configuration (Multimodal Vision & Agronomy Chat)
# ------------------------------------------------------------------------------
# Primary AI Provider: 'gemini', 'groq', or 'openrouter'
AI_PROVIDER_DEFAULT=gemini

# Primary Vision & Multimodal Model for Crop Disease Scan
AI_VISION_MODEL=gemini-2.5-flash

# Fast Multimodal / Text Model for Agronomy Chatbot
AI_CHAT_MODEL=gemini-2.5-flash

# Primary Provider Secret Key (Google AI Studio / Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary Provider Secret Key (Groq Cloud - Fast Fallback)
GROQ_API_KEY=your_groq_api_key_here

# Tertiary Provider Secret Key (OpenRouter - Universal Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 3. AI Safety, Budgeting & Quota Caps
# ------------------------------------------------------------------------------
# Daily maximum AI calls across all users to prevent billing shock
AI_DAILY_REQUEST_CAP=500

# Emergency Kill Switch: Set to 'true' to safely suspend AI features if exhausted
AI_KILL_SWITCH=false

# ------------------------------------------------------------------------------
# 4. App & Deployment Settings
# ------------------------------------------------------------------------------
# Base URL for metadata, auth redirects, and public links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App Version & Beta / Pilot Indicator
NEXT_PUBLIC_APP_ENV=pilot
